---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EcoMilesPortal } from '../../islands/EcoMilesPortal';

export const prerender = true;
export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    { params: { slug: 'dashboard' } },
    { params: { slug: 'benchmark' } },
    { params: { slug: 'dispatcher' } },
    { params: { slug: 'driver' } },
    { params: { slug: 'audit' } },
  ];
}
const { slug } = Astro.params;
const initialRoute = slug ? `/${slug}` : '/dashboard';
---

<BaseLayout
  title="EcoMiles: Cổng Quản Trị & Vận Hành Doanh Nghiệp"
  description="Cổng vận hành logistics đô thị EcoMiles: Báo cáo tự động, Bàn điều phối, Ứng dụng Tài xế và Kiểm định lộ trình."
>
  <EcoMilesPortal client:only="react" initialRoute={initialRoute} />
</BaseLayout>
