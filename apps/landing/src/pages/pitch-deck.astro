---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { PitchDeckVoiceoverPage } from '../components/PitchDeckVoiceoverPage';
---

<BaseLayout
  title="EcoMiles: Hồ Sơ Thuyết Trình & Kịch Bản Điều Hành"
  description="Hồ sơ thuyết trình và mô phỏng vận hành thực tế nền tảng tối ưu vận tải đô thị EcoMiles."
>
  <PitchDeckVoiceoverPage
    client:load
    onBackToHome={() => {
      if (typeof window !== 'undefined') window.location.href = '/';
    }}
  />
</BaseLayout>
