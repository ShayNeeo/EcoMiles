---
import '../index.css';
import '../App.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'EcoMiles · Đường về không trống · Điều phối xe tải & kiểm toán CO₂',
  description = 'EcoMiles tối ưu tuyến giao hàng TP.HCM & Hà Nội trên 2.895 đơn hàng thật: giảm 30,5-50,8% km so với tra Google Maps từng điểm, 0 lỗi giờ cấm QĐ 23/2018 & QCVN 41:2024.',
} = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: Bricolage Grotesque (Display), Be Vietnam Pro (UI Body), JetBrains Mono (Telemetry Data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=JetBrains+Mono:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:image" content="https://ecomiles.pages.dev/pitch-deck-screenshots/00_ecomiles_flagship_cover_banner.png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ecomiles.pages.dev/pitch-deck-screenshots/00_ecomiles_flagship_cover_banner.png" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#003049" />
    <script is:inline src="/vendor/echarts.min.js"></script>
  </head>
  <body class="bg-[#FDF0D5] text-[#003049] antialiased selection:bg-[#C1121F] selection:text-[#FDF0D5] overflow-x-hidden min-h-screen">
    <slot />
  </body>
</html>
