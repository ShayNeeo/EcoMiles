---
import '../index.css';
import '../App.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'EcoMiles · Đường về không trống — Điều phối đội xe & kiểm toán carbon ISO 14083',
  description = 'EcoMiles tối ưu tuyến giao hàng đô thị TP.HCM, ghép đơn chiều về giảm 34,9% quãng đường, tuân thủ khung giờ cấm tải QĐ 23/2018 và xuất sổ phát thải chuẩn ISO 14083 / GLEC v3.2.',
} = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Archivo (Display), IBM Plex Sans (Body), JetBrains Mono (Data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- SEO Meta Tags in Vietnamese -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:image" content="https://ecomiles.pages.dev/pitch-deck-screenshots/00_ecomiles_flagship_cover_banner.png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ecomiles.pages.dev/pitch-deck-screenshots/00_ecomiles_flagship_cover_banner.png" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#101418" />
    <!-- Vendored Apache ECharts 5.5.1 (offline-ready, Apache-2.0) -->
    <script is:inline src="/vendor/echarts.min.js"></script>
  </head>
  <body class="bg-[#F6F1E7] text-[#101418] antialiased selection:bg-[#101418] selection:text-[#F6F1E7] overflow-x-hidden min-h-screen">
    <slot />
  </body>
</html>
