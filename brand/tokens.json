{
  "$schema": "https://ecomiles.vn/schemas/brand-tokens.v1.json",
  "brand": {
    "name": "EcoMiles",
    "wordmark": "ECOMILES▪",
    "tagline": "Đường về không trống.",
    "personality": ["Đường phố Việt", "Nhà đầu tư sắc gọn"],
    "territory": "Đường về / vòng lặp tuyến",
    "gate": {
      "g1_signed_by": "Phạm Quốc Thanh",
      "g1_signed_at": "2026-11-16",
      "mark": "A · Return M",
      "typography": "A · Archivo + IBM Plex Sans + JetBrains Mono",
      "palette": "A · Asphalt & Paper",
      "tagline": "Đường về không trống."
    }
  },
  "color": {
    "surface": {
      "paper": { "value": "#F6F1E7", "role": "Primary daylight canvas" },
      "paperCard": { "value": "#FBF8F1", "role": "Elevated ledger card / panel" },
      "paperPure": { "value": "#FFFFFF", "role": "High-density data table / input surface" },
      "paperSunken": { "value": "#ECE5D7", "role": "Recessed strip / inactive schedule band" }
    },
    "ink": {
      "primary": { "value": "#101418", "role": "Asphalt ink — headlines, primary figures, dark driver shell" },
      "body": { "value": "#2A2F36", "role": "Body prose (11.97:1 on #F6F1E7)" },
      "muted": { "value": "#5B5F66", "role": "Secondary labels, table captions (5.70:1 on #F6F1E7)" },
      "inverse": { "value": "#F6F1E7", "role": "Primary text on asphalt ink" },
      "inverseMuted": { "value": "#C9C3B6", "role": "Secondary mono labels on asphalt ink" }
    },
    "border": {
      "hairline": { "value": "#D8D2C4", "role": "1px structural hairline" },
      "strong": { "value": "#BDB5A3", "role": "Input / active table border" },
      "ink": { "value": "#101418", "role": "High-contrast ledger rule" }
    },
    "semantic": {
      "routeCobalt": { "value": "#1B45D7", "role": "Active route polyline, primary analytical link (6.48:1 on #F6F1E7)" },
      "routeCobaltTint": { "value": "#EEF2FC", "role": "Route callout wash" },
      "verifiedGreen": { "value": "#0B7A3B", "role": "Verified numbers, matched backhaul, issued ISO seals ONLY (4.83:1 on #F6F1E7)" },
      "verifiedGreenTint": { "value": "#EAF5EE", "role": "Verified badge surface" },
      "windowAmber": { "value": "#A64B08", "role": "QĐ 23/2018 staging / waiting window ONLY (5.14:1 on #F6F1E7)" },
      "windowAmberTint": { "value": "#FDF3E7", "role": "QĐ 23 warning surface" },
      "violationRed": { "value": "#B42318", "role": "QĐ 23 ban violation, 401/403 denial, SLA breach ONLY (5.84:1 on #F6F1E7)" },
      "violationRedTint": { "value": "#FCECEB", "role": "Violation alert surface" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": "'Archivo', 'IBM Plex Sans', system-ui, sans-serif",
      "body": "'IBM Plex Sans', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
    },
    "scale": {
      "hero": { "size": "clamp(40px, 6.4vw, 84px)", "lineHeight": 0.96, "letterSpacing": "-0.04em", "weight": 800 },
      "h1": { "size": "clamp(32px, 4vw, 52px)", "lineHeight": 1.04, "letterSpacing": "-0.03em", "weight": 800 },
      "h2": { "size": "clamp(24px, 2.6vw, 34px)", "lineHeight": 1.12, "letterSpacing": "-0.02em", "weight": 700 },
      "h3": { "size": "18px", "lineHeight": 1.3, "letterSpacing": "-0.01em", "weight": 700 },
      "body": { "size": "15px", "lineHeight": 1.6, "letterSpacing": "0em", "weight": 400 },
      "small": { "size": "13px", "lineHeight": 1.5, "letterSpacing": "0em", "weight": 500 },
      "monoLabel": { "size": "11px", "lineHeight": 1.3, "letterSpacing": "0.12em", "weight": 600 }
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px",
    "24": "96px"
  },
  "radius": {
    "none": "0px",
    "xs": "2px",
    "sm": "4px",
    "driver": "8px",
    "appIcon": "14px"
  },
  "motion": {
    "drawDurationMs": 600,
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "once": true,
    "reducedMotion": "instant"
  },
  "dataViz": {
    "emptyLegDash": "8 8",
    "matchedLegStroke": "solid",
    "stopNodeShape": "square-terminal",
    "greenCertifiesOnly": true
  }
}
